{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/404.html", "/404.css", "/*.{css,js,json,svg,png,jpg,jpeg,webp,avif}"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/sw.js",
      "headers": { "cache-control": "no-cache" }
    }
  ]
}
